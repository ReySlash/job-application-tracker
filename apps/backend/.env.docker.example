# Backend container env template for `docker run --env-file`.
# Keep values unquoted. Docker passes quote characters through literally.
# Do not include frontend `VITE_*` variables in this file.

NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/job_application_tracker?sslmode=require&channel_binding=require
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-vercel-project.vercel.app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
